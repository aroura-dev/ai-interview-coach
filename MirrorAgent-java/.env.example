# DashScope LLM (Required)
DASHSCOPE_API_KEY=sk-your-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/mirror_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me-for-local-dev

# JWT
JWT_SECRET=replace-with-at-least-32-random-characters

# GitHub (Optional)
GITHUB_TOKEN=

# Auth
AUTH_ENABLED=true
