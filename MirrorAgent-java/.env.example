# DashScope LLM (Required)
DASHSCOPE_API_KEY=sk-your-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL（后端使用专用应用账号，不直接使用 root）
MYSQL_URL=jdbc:mysql://localhost:3308/mirror_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=mirror_agent
MYSQL_PASSWORD=mirror_agent
MYSQL_ROOT_PASSWORD=interview
MYSQL_APP_USER=mirror_agent
MYSQL_APP_PASSWORD=mirror_agent

# MinIO（Milvus 内部对象存储）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT（生产环境必须替换为至少 32 位随机字符串）
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000

# GitHub (Optional)
GITHUB_TOKEN=

# Auth
AUTH_ENABLED=true