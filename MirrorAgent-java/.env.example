# DashScope LLM (Required)
DASHSCOPE_API_KEY=sk-your-api-key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL（默认值与 MirrorAgent-java/docker-compose.yml 一致：宿主机端口 3308）
MYSQL_URL=jdbc:mysql://localhost:3308/mirror_agent?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=interview

# JWT（生产环境必须替换为至少 32 位随机字符串）
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000

# GitHub (Optional)
GITHUB_TOKEN=

# Auth
AUTH_ENABLED=true